pkgname=grold-omarchy-vpn
pkgver=0.1.0
pkgrel=1
pkgdesc='WireGuard and AmneziaWG VPN connection manager and widget for Omarchy Linux'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-quickcontrols2' 'qt6-wayland' 'xdg-desktop-portal' 'amneziawg-tools' 'nftables' 'iproute2')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-quickcontrols2')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/src/grold-omarchy-vpn "$pkgdir/usr/bin/grold-omarchy-vpn"
  install -Dm755 build/daemon/grold-omarchy-vpnd "$pkgdir/usr/bin/grold-omarchy-vpnd"
  install -Dm755 build/cli/ctl/grold-omarchy-vpn-ctl "$pkgdir/usr/bin/grold-omarchy-vpn-ctl"
  install -Dm755 build/cli/runner/grold-omarchy-vpn-run "$pkgdir/usr/bin/grold-omarchy-vpn-run"
  install -Dm644 daemon/grold-omarchy-vpnd.service "$pkgdir/usr/lib/systemd/system/grold-omarchy-vpnd.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/grold-omarchy-vpn.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/grold-omarchy-vpn.svg"
  install -Dm644 "$startdir/grold-omarchy-vpn.desktop" "$pkgdir/usr/share/applications/grold-omarchy-vpn.desktop"

  # Shell plugin files
  install -d "$pkgdir/usr/share/omarchy/shell/plugins/grold.vpn"
  install -m644 plugin/manifest.json "$pkgdir/usr/share/omarchy/shell/plugins/grold.vpn/manifest.json"
  install -m644 plugin/Panel.qml "$pkgdir/usr/share/omarchy/shell/plugins/grold.vpn/Panel.qml"
  install -m644 plugin/Service.qml "$pkgdir/usr/share/omarchy/shell/plugins/grold.vpn/Service.qml"
  install -m644 plugin/VpnIcon.qml "$pkgdir/usr/share/omarchy/shell/plugins/grold.vpn/VpnIcon.qml"
}
